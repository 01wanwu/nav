{
  "name": "conan-nav",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/open-next-postbuild.mjs",
    "start": "node --max-http-header-size=65536 node_modules/next/dist/bin/next start -p 3000",
    "lint": "next lint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "tsx scripts/verify-bookmarks.ts && tsx scripts/verify-workspace.ts && tsx scripts/domain-verify-selftest.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "postinstall": "node scripts/generate-prisma.mjs && node scripts/db-bootstrap.mjs",
    "db:push": "node scripts/db-sqlite.mjs && npm run db:seed",
    "db:push:pg": "npx prisma db push --schema prisma/schema.prisma",
    "db:setup": "node scripts/sync-schemas.mjs && node scripts/db-sqlite.mjs && npm run db:seed:full",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:full": "npx tsx prisma/seed.ts full",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:studio": "npx prisma studio --schema prisma/schema.sqlite.prisma"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jinrishici": "^1.0.6",
    "lucide-react": "^0.462.0",
    "next": "^15.5.9",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.29.3",
    "prisma": "^6.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "transliteration": "^2.6.0",
    "tsx": "^4.21.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/transliteration": "^1.6.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^8",
    "eslint-config-next": "15.5.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
