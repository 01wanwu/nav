// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Workspace {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  description     String?
  // 展示覆盖项：为空时回退 SystemSettings 对应值
  siteName        String?    @map("site_name")
  siteDescription String?    @map("site_description")
  siteLogo        String?    @map("site_logo")
  favicon         String?
  // About 页内容覆盖项：为空时回退 SystemSettings.aboutContent
  aboutContent    String?    @map("about_content")
  isDefault       Boolean    @default(false) @map("is_default")
  // 未发布工作区对前台按「未匹配域名」处理（渲染默认工作区）
  isPublished     Boolean    @default(false) @map("is_published")
  order           Int        @default(0)
  domains         Domain[]
  categories      Category[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("Workspace")
}

model Domain {
  id          String    @id @default(cuid())
  // 规范化主机名：小写、无协议、无端口
  host        String    @unique
  isPrimary   Boolean   @default(false) @map("is_primary")
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 最近一次反向探测结果：ok=渲染了本工作区 fallback=渲染了其他工作区 unreachable=不可达/非本应用
  lastVerifiedStatus String?   @map("last_verified_status")
  lastVerifiedAt     DateTime? @map("last_verified_at")
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("Domain")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String
  icon        String?
  order       Int       @default(0)
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  sites       Site[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("Category")
}

model Site {
  id               String    @id @default(cuid())
  name             String
  url              String
  description      String
  iconUrl          String?   @map("icon_url")
  // site-submission 插件字段：投稿者联系方式与来源 IP（管理员创建时为空）
  submitterContact String?   @map("submitter_contact")
  submitterIp      String?   @map("submitter_ip")
  categoryId       String
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPublished      Boolean   @default(false)
  isPinned         Boolean   @default(false)
  order            Int       @default(0)
  detailContent    String?   @map("detail_content")
  hasDetail        Boolean   @default(false) @map("has_detail")
  // 测活（健康检测）结果，由管理后台手动触发写入
  healthStatus     String    @default("unknown") @map("health_status") // unknown | up | suspicious | down
  lastHttpStatus   Int?      @map("last_http_status")
  latencyMs        Int?      @map("latency_ms")
  lastCheckedAt    DateTime? @map("last_checked_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  visits           Visit[]
  screenshots      Screenshot[]

  @@index([categoryId])
  @@index([isPublished])
  @@index([isPinned])
  @@index([categoryId, isPublished])
  @@index([order])
  @@map("Site")
}

enum ScreenshotSource {
  URL
  UPLOAD
}

model Screenshot {
  id        String           @id @default(cuid())
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    ScreenshotSource
  url       String?
  data      String?
  mimeType  String?          @map("mime_type")
  order     Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([siteId])
  @@map("Screenshot")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  role      UserRole @default(ADMIN)
  // 改密时间：会话校验时与 token 签发时间比对，改密后吊销所有旧会话（null=从未改密）
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
}

model SystemSettings {
  id               String   @id @default("default") @map("id")
  siteName         String   @default("Conan Nav") @map("site_name")
  siteDescription  String   @default("简洁现代化的网址导航系统") @map("site_description")
  siteLogo         String?  @map("site_logo")
  favicon          String?  @map("favicon")
  pageSize         Int      @default(20) @map("page_size")
  // Footer settings
  showFooter        Boolean  @default(true) @map("show_footer")
  footerCopyright  String   @map("footer_copyright")  // 默认值由 seed.ts 动态生成
  footerLinks      Json     @default(dbgenerated("'[]'")) @map("footer_links")
  showAdminLink    Boolean  @default(true) @map("show_admin_link")
  // ICP filing settings (备案信息)
  showIcp          Boolean  @default(false) @map("show_icp")
  icpNumber        String?  @map("icp_number")
  icpLink          String?  @map("icp_link")
  // About 页内容（展示与否由 about-page 内置插件启停控制）；
  // 工作区 about_content 为空时回退此处全局默认内容。
  // 注：原 enableVisitTracking / enableSiteDetail / enablePoetry /
  // enableAboutPage 功能开关均已迁移为内置插件，启停统一存于下方 enabledPlugins
  aboutContent         String?  @map("about_content")
  // Plugin system (插件启停状态与各插件配置，键为注册表中的插件 ID)
  enabledPlugins       Json     @default(dbgenerated("'[]'")) @map("enabled_plugins")
  pluginConfigs        Json     @default(dbgenerated("'{}'")) @map("plugin_configs")
  // GitHub link
  githubUrl        String?  @map("github_url")
  // 自定义代码（管理员注入，仅前台导航页渲染，见 app/(public)/layout.tsx；仅信任管理员输入）
  // customHeadCode：注入前台 body 起始处（页面加载早期执行，适合统计/验证脚本）
  // customBodyCode：注入前台内容结尾（水合后执行，适合特效/挂件/客服）
  customHeadCode   String?  @map("custom_head_code")
  customBodyCode   String?  @map("custom_body_code")
  // Default site language for visitors without a locale cookie (zh/en)
  defaultLanguage  String   @default("zh") @map("default_language")
  // 页面动效总开关（开启后前台与后台具备丝滑动画效果，关闭后所有动效被禁用）
  enableAnimations Boolean  @default(true) @map("enable_animations")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("SystemSettings")
}

// 上传插件（声明式 manifest 包）。内置插件走代码注册表，
// 启停状态存 SystemSettings.enabledPlugins；上传插件独立启停。
model Plugin {
  id        String   @id
  manifest  Json
  enabled   Boolean  @default(false)
  configs   Json     @default(dbgenerated("'{}'"))
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("Plugin")
}

model Visit {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  referer   String?
  visitedAt DateTime @default(now())

  @@index([siteId])
  @@index([visitedAt])
  @@index([siteId, visitedAt])
}
